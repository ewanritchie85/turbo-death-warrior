# Template for Turbo Death Warrior server configuration.
# Copy this file to .env and adjust the values.

# Interface to bind: 127.0.0.1 (local only) or 0.0.0.0 (LAN access)
TDW_HOST=127.0.0.1

# Port the web server listens on
TDW_PORT=8001

# How long a game can sit idle before being evicted (seconds)
TDW_GAME_TTL_SECONDS=3600

# How often the sweep runs (seconds)
TDW_SWEEP_INTERVAL_SECONDS=300
